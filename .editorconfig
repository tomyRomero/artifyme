# Code style for the API and its tests, read by editors and `dotnet format`
root = true

[*.cs]
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# One namespace per file, without an extra level of indentation
csharp_style_namespace_declarations = file_scoped:warning

# Usings sorted, System first
dotnet_sort_system_directives_first = true

# Usings that nothing uses
dotnet_diagnostic.IDE0005.severity = warning

# EF Core writes these; they're left as generated
[backend/Migrations/*.cs]
generated_code = true
