{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Imports start from src/ (and assets/) instead of climbing with ../../
    "paths": {
      "@/assets/*": ["./assets/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
