{
  "expo": {
    "name": "ArtifyMe",
    "slug": "artifyme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "artifyme",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#5800FF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow ArtifyMe to use Face ID to sign you in and unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5800FF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F3FF",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#0D0B1E"
          }
        }
      ],
      "expo-status-bar",
      "expo-image",
      "expo-sharing",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow ArtifyMe to use Face ID to sign you in and unlock the app."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "ArtifyMe adds an artwork to your photos when you choose Save to Photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
