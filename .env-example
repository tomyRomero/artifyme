# Copy this file to .env (which is never committed) and choose a password.
# SQL Server requires at least 8 characters with three of: uppercase, lowercase, digits, symbols.
# The API's connection string uses the same password; see "Running it" in the README.
MSSQL_SA_PASSWORD=

# Only for the whole app in containers (docker compose --profile app up -d --build --wait):
# The API's signing secret, at least 32 bytes. Make one with: openssl rand -base64 48
JWT_SECRET=
# A key the API and the image service share. Optional in mock mode, required in real mode.
INFERENCE_API_KEY=
# mock: a quick stand-in image. real: Stable Diffusion, which also needs INFERENCE_EXTRAS=real (several GB)
# and INFERENCE_MEMORY=8g.
INFERENCE_MODE=mock
INFERENCE_EXTRAS=

# Optional: store images in Cloudflare R2. Without these, the API keeps them in a local folder.
# From the R2 dashboard: the bucket's name, the account's S3 API address
# (https://<account id>.r2.cloudflarestorage.com), and an API token's access key ID and secret, with
# Object Read & Write on that bucket only. (For dotnet run, the same values go in user-secrets; see the README.)
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: only when push notifications are set to require an access token in the Expo project's settings.
# (For dotnet run, it goes in user-secrets as Push:AccessToken.)
EXPO_ACCESS_TOKEN=
